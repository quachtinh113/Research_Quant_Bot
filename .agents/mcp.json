{
  "mcpServers": {
    "quant-server": {
      "command": ".venv/Scripts/python.exe",
      "args": [
        "mcp/quant_server/server.py"
      ],
      "env": {
        "QUANT_REPO_ROOT": ".",
        "PYTHONPATH": "."
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "mcp/memory.jsonl"
      }
    }
  }
}
