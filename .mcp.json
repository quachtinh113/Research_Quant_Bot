{
  "mcpServers": {
    "quant-server": {
      "command": ".venv/Scripts/python.exe",
      "args": [
        "mcp/quant_server/server.py"
      ],
      "env": {
        "QUANT_REPO_ROOT": ".",
        "PYTHONPATH": "."
      }
    },
    "quant_mcp": {
      "command": "${QUANT_MERG_PYTHON:-C:/Users/Pro Trader/AppData/Local/Programs/Python/Python312/python.exe}",
      "args": [
        "${QUANT_MERG_ROOT:-D:/05_Quant/merg}/quant_mcp/server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "mcp/memory.jsonl"
      }
    }
  }
}
